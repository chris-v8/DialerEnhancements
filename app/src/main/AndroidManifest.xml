<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app see Google Phone (its version, its launcher screen, and who is calling the bridge). -->
    <queries>
        <package android:name="com.google.android.dialer" />
    </queries>

    <!-- The LSPosed manager shows android:label as the module name and android:description as its description. -->
    <application
        android:name=".app.ModuleApp"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DialerEnhancements">

        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Phone reports here. The provider itself only accepts this app and Google Phone. -->
        <provider
            android:name=".app.BridgeProvider"
            android:authorities="${applicationId}.bridge"
            android:exported="true" />
    </application>

</manifest>
