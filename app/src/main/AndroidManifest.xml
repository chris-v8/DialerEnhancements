<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lists the user's phone numbers in the Selected-numbers picker. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Lets the app see Google Phone (its version, its launcher screen, and who is calling the bridge). -->
    <queries>
        <package android:name="com.google.android.dialer" />
    </queries>

    <!-- The LSPosed manager shows android:label as the module name and android:description as its description. -->
    <application
        android:name=".app.ModuleApp"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DialerEnhancements">

        <!-- No launcher icon: the LSPosed manager opens this screen when the module is tapped. -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- Opened by Google Phone's Add button (for a result) and from this app. It refuses
             results to any other app. -->
        <activity
            android:name=".app.picker.NumberPickerActivity"
            android:exported="true"
            android:label="@string/picker_title" />

        <!-- Google Phone reports here. The provider itself only accepts this app and Google Phone. -->
        <provider
            android:name=".app.BridgeProvider"
            android:authorities="${applicationId}.bridge"
            android:exported="true" />
    </application>

</manifest>
